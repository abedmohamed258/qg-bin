        if active_only:
            sql = "SELECT * FROM bundle_recharges WHERE active = 1 ORDER BY expires_at ASC, id ASC"
        else:
            sql = "SELECT * FROM bundle_recharges ORDER BY active DESC, expires_at ASC, id ASC"
