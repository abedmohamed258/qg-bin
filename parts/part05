    // ==========================================
    // LIVE DIRECT STREAM ENGINE (ZERO DISK RELAY)
    // ==========================================
    let liveWs = null;
    let liveSelfId = null;
    let livePeers = [];
    let activeTransfer = null;
    let targetPeerForUpload = null;
    let targetPeerForUploadIp = "";
    let pendingIncomingRequest = null;
    let acceptTimeoutTimer = null;
    let liveWsPingInterval = null;
    let liveWakeLock = null;
    let activeDownloadUrl = null;
    let activeDownloadName = "";
    const myDeviceName = localStorage.getItem("qm_live_dev_name") || "";

    async function requestScreenWakeLock() {
      if ("wakeLock" in navigator) {
        try {
          if (!liveWakeLock) {
            liveWakeLock = await navigator.wakeLock.request("screen");
            liveWakeLock.addEventListener("release", () => {
              liveWakeLock = null;
            });
          }
        } catch (e) {
          // May fail if tab invisible or power saver enforced
        }
      }
    }

    function releaseScreenWakeLock() {
      if (liveWakeLock) {
        try {
          liveWakeLock.release();
        } catch (e) {}
        liveWakeLock = null;
      }
    }

    document.addEventListener("visibilitychange", async () => {
      if (document.visibilityState === "visible") {
        if (activeTransfer) {
          await requestScreenWakeLock();
