            <div class="peer-ip">${escapeHtml(p.ip)}</div>
            <div class="peer-actions-btn-group">
              <button type="button" class="peer-send-btn peer-send-files" data-peer-id="${escapeHtml(p.id)}" title="Send one or multiple files directly">
                Files ðŸ“
              </button>
              <button type="button" class="peer-send-btn folder peer-send-folder" data-peer-id="${escapeHtml(p.id)}" title="Send one or multiple folders directly">
                Folders ðŸ“‚
              </button>
