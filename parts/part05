      QMI.apply(container);
    }

    function getDeviceIcon(name) {
      const n = (name || "").toLowerCase();
      if (n.includes("phone") || n.includes("iphone") || n.includes("android")) return "ðŸ“±";
      if (n.includes("pc") || n.includes("windows") || n.includes("laptop") || n.includes("mac") || n.includes("linux")) return "ðŸ’»";
      if (n.includes("tv")) return "ðŸ“º";
      if (n.includes("pad") || n.includes("tablet")) return "ðŸ“±";
