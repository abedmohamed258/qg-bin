    function clearTransferAcceptTimeout() {
      if (acceptTimeoutTimer) {
        clearTimeout(acceptTimeoutTimer);
        acceptTimeoutTimer = null;
      }
    }

    function startTransferAcceptTimeout(transferId) {
      clearTransferAcceptTimeout();
      acceptTimeoutTimer = setTimeout(() => {
        if (activeTransfer && activeTransfer.id === transferId && activeTransfer.role === "sender") {
          finishLiveTransfer(QMI.t("Transfer timed out: Receiver did not respond in time."));
          if (liveWs && liveWs.readyState === WebSocket.OPEN) {
            liveWs.send(JSON.stringify({
              type: "transfer-cancel",
              transfer_id: transferId,
              target_id: activeTransfer.targetId,
              target_ip: activeTransfer.targetIp
            }));
          }
        }
      }, 45000);
    }

    function initLiveShare() {
      const proto = window.location.protocol === "https:" ? "wss:" : "ws:";
      const devParam = myDeviceName ? `?name=${encodeURIComponent(myDeviceName)}` : "";
      const wsUrl = `${proto}//${window.location.host}/api/share/live/ws${devParam}`;

      try {
        liveWs = new WebSocket(wsUrl);
      } catch (e) {
        console.warn("WebSocket init error:", e);
        return;
      }

      liveWs.binaryType = "arraybuffer";

      liveWs.onopen = () => {
        if (myDeviceName) {
          liveWs.send(JSON.stringify({ type: "join", name: myDeviceName }));
        }
        if (liveWsPingInterval) clearInterval(liveWsPingInterval);
        liveWsPingInterval = setInterval(() => {
          if (liveWs && liveWs.readyState === WebSocket.OPEN) {
            liveWs.send(JSON.stringify({ type: "ping" }));
          }
        }, 3000); // 3s ping keeps mobile connection warm and avoids Wi-Fi sleep
      };

      liveWs.onmessage = async (event) => {
        let data = event.data;
        if (data instanceof Blob) {
          data = await data.arrayBuffer();
        }
        if (data instanceof ArrayBuffer) {
          handleBinaryChunk(data);
          return;
        }

        try {
          const msg = JSON.parse(data);
          handleLiveMessage(msg);
        } catch (e) {
          // ignore
        }
      };

      liveWs.onclose = () => {
        clearTransferAcceptTimeout();
        if (activeTransfer && activeTransfer.role === "sender" && !activeTransfer.cancelled) {
          finishLiveTransfer(QMI.t("Live connection interrupted. Reconnecting..."));
        }
        setTimeout(initLiveShare, 2000);
      };
    }

    // Ultra-fast slicing-by-8 incremental CRC32 calculator (>700 MB/s line rate)
    const liveCrcTables = [];
    for (let i = 0; i < 8; i++) liveCrcTables.push(new Uint32Array(256));
    for (let i = 0; i < 256; i++) {
      let c = i;
      for (let k = 0; k < 8; k++) c = (c & 1) ? (0xEDB88320 ^ (c >>> 1)) : (c >>> 1);
      liveCrcTables[0][i] = c >>> 0;
    }
    for (let i = 0; i < 256; i++) {
      for (let k = 1; k < 8; k++) {
        liveCrcTables[k][i] = (liveCrcTables[k - 1][i] >>> 8) ^ liveCrcTables[0][liveCrcTables[k - 1][i] & 0xFF];
      }
    }
    const [lcT0, lcT1, lcT2, lcT3, lcT4, lcT5, lcT6, lcT7] = liveCrcTables;

    function updateLiveCrc32(runningCrc, uint8) {
      let crc = runningCrc >>> 0;
      let len = uint8.length;
      let pos = 0;
      while (len >= 8) {
        const one = (uint8[pos] ^ (crc & 0xFF));
        const two = (uint8[pos + 1] ^ ((crc >>> 8) & 0xFF));
        const three = (uint8[pos + 2] ^ ((crc >>> 16) & 0xFF));
        const four = (uint8[pos + 3] ^ (crc >>> 24));
        crc = lcT7[one] ^ lcT6[two] ^ lcT5[three] ^ lcT4[four] ^
              lcT3[uint8[pos + 4]] ^ lcT2[uint8[pos + 5]] ^ lcT1[uint8[pos + 6]] ^ lcT0[uint8[pos + 7]];
        pos += 8;
        len -= 8;
      }
      while (len > 0) {
        crc = (crc >>> 8) ^ lcT0[(crc ^ uint8[pos]) & 0xFF];
        pos++;
        len--;
      }
      return crc >>> 0;
    }

    function handleLiveMessage(msg) {
      if (msg.type === "peers") {
        liveSelfId = msg.self_id || liveSelfId;
        const myIp = msg.self_ip || (currentShareData && currentShareData.client_ip) || "";
        const rawPeers = (msg.peers || []).filter(p => p.id !== liveSelfId && (!myIp || p.ip !== myIp));
        const seenIps = new Set();
        livePeers = [];
        for (const p of rawPeers) {
          if (!seenIps.has(p.ip)) {
            seenIps.add(p.ip);
            livePeers.push(p);
          }
        }
        renderLivePeers();
      } else if (msg.type === "transfer-request") {
        pendingIncomingRequest = msg;
        requestScreenWakeLock();
        try {
          if (navigator.vibrate) navigator.vibrate([150, 80, 150]);
        } catch (e) {}
        $("incoming-sender-text").textContent = QMI.t("\"{name}\" ({ip}) wants to send:", {name: msg.sender_name, ip: msg.sender_ip});
        $("incoming-file-name").textContent = msg.file_name;
        $("incoming-file-size").textContent = formatBytes(msg.file_size);
        $("live-incoming-modal").classList.remove("hidden");
      } else if (msg.type === "transfer-response") {
        if (activeTransfer && activeTransfer.id === msg.transfer_id && activeTransfer.role === "sender") {
          clearTransferAcceptTimeout();
          if (msg.accepted) {
            startLiveSenderStream();
          } else {
            finishLiveTransfer(QMI.t("Transfer declined by receiver"));
          }
        }
      } else if (msg.type === "transfer-progress") {
        if (activeTransfer && activeTransfer.id === msg.transfer_id && activeTransfer.role === "receiver") {
          activeTransfer.currentBytes = msg.loaded;
          updateLiveProgressThrottled(msg.loaded, msg.total, activeTransfer.startTime);
        }
      } else if (msg.type === "transfer-error") {
        clearTransferAcceptTimeout();
        finishLiveTransfer(msg.message || QMI.t("Target device is offline or unavailable."));
      } else if (msg.type === "transfer-done") {
        if (activeTransfer && activeTransfer.id === msg.transfer_id && activeTransfer.role === "receiver") {
          finishLiveReceiver();
        }
      } else if (msg.type === "transfer-cancel") {
        if (activeTransfer && activeTransfer.id === msg.transfer_id) {
          clearTransferAcceptTimeout();
          finishLiveTransfer(QMI.t("Transfer cancelled by other device"));
        }
      }
    }

    function renderLivePeers() {
      const container = $("live-peers-list");
      const countEl = $("live-peers-count");
      if (!container) return;
      if (countEl) countEl.textContent = QMI.t("{count} online", {count: livePeers.length});

      if (livePeers.length === 0) {
        container.innerHTML = `
          <div class="live-empty-peers">
            <div class="radar-pulse"></div>
            <div style="font-size: 0.84rem; font-weight: 500; color: var(--text-2); margin-top: 10px;">Waiting for other devices on your Wi-Fi...</div>
            <div style="font-size: 0.73rem; color: var(--text-3); margin-top: 2px;">Open Local Share on your other phone or PC to transfer directly over Wi-Fi.</div>
          </div>
        `;
        QMI.apply(container);
        return;
      }

      container.innerHTML = livePeers.map(p => {
        const icon = getDeviceIcon(p.name);
        return `
          <div class="peer-card" data-peer-id="${escapeHtml(p.id)}">
            <div class="peer-avatar">${icon}</div>
