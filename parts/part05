    function formatBytes(bytes) {
      if (!bytes || bytes === 0) return "\u20660 B\u2069";
      const k = 1024;
      const sizes = ["B", "KB", "MB", "GB", "TB"];
      const i = Math.floor(Math.log(bytes) / Math.log(k));
      return "\u2066" + parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + " " + sizes[i] + "\u2069";
    }

    function formatTimeAgo(epochSec) {
      const diff = Math.max(0, Math.floor(Date.now() / 1000 - epochSec));
      if (diff < 60) return QMI.t("just now");
      if (diff < 3600) return QMI.t("{n}m ago", {n: Math.floor(diff / 60)});
      if (diff < 86400) return QMI.t("{n}h ago", {n: Math.floor(diff / 3600)});
      return QMI.t("{n}d ago", {n: Math.floor(diff / 86400)});
    }

    function formatExpiry(epochSec) {
      const left = Math.max(0, Math.floor(epochSec - Date.now() / 1000));
      if (left <= 0) return QMI.t("expired");
      if (left < 60) return QMI.t("{n}s left", {n: left});
      if (left < 3600) return QMI.t("{n}m left", {n: Math.floor(left / 60)});
      return QMI.t("{h}h {m}m left", {h: Math.floor(left / 3600), m: Math.floor((left % 3600) / 60)});
