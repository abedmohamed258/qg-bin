    exceptions      TEXT NOT NULL DEFAULT '[]',   -- JSON array
    expires_at      TEXT NOT NULL DEFAULT '',
    enforcement_method TEXT NOT NULL DEFAULT 'dns',
    log_enabled     INTEGER NOT NULL DEFAULT 1,
    created_at      TEXT NOT NULL DEFAULT '',
