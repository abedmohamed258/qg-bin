    // UPLOAD REGULAR FILES
    function uploadFiles(files) {
      if (!files || files.length === 0) return;
      const progressCard = $("upload-progress-card");
      const nameEl = $("upload-filename");
      const statsEl = $("upload-stats");
      const barEl = $("upload-bar-fill");

      progressCard.classList.remove("hidden");
      let currentFileIndex = 0;
      const job = activeUpload = { cancelled: false, xhr: null };

      function uploadNext() {
        if (currentFileIndex >= files.length) {
          setTimeout(() => progressCard.classList.add("hidden"), 1200);
          showToast(QMI.t("Successfully shared {count} file(s)!", {count: files.length}));
          fetchShareData();
          return;
        }

        const file = files[currentFileIndex];
        nameEl.textContent = QMI.t("Uploading ({i}/{n}): {name}", {i: currentFileIndex + 1, n: files.length, name: file.name});
        barEl.style.width = "0%";
        statsEl.textContent = "0%";

        const xhr = new XMLHttpRequest();
        job.xhr = xhr;
        let startTime = Date.now();

        xhr.upload.onprogress = (e) => {
          if (e.lengthComputable) {
            const percent = Math.round((e.loaded / e.total) * 100);
            barEl.style.width = `${percent}%`;
            const elapsedSec = (Date.now() - startTime) / 1000;
            const speedBytesSec = elapsedSec > 0 ? e.loaded / elapsedSec : 0;
            statsEl.textContent = `${percent}% (${formatBytes(e.loaded)} / ${formatBytes(e.total)}) â€¢ ${formatBytes(speedBytesSec)}/s`;
          }
        };

        xhr.onload = () => {
          if (job.cancelled) return;
          if (xhr.status >= 200 && xhr.status < 300) {
            currentFileIndex++;
            uploadNext();
          } else {
            showToast(QMI.t("Upload failed: {err}", {err: xhr.statusText || xhr.status}));
            progressCard.classList.add("hidden");
          }
        };

        xhr.onerror = () => {
          if (job.cancelled) return;
          showToast(QMI.t("Network error during upload"));
          progressCard.classList.add("hidden");
        };

        xhr.open("POST", "/api/share/upload");
        xhr.setRequestHeader("X-Filename", encodeURIComponent(file.name));
        xhr.setRequestHeader("Content-Type", file.type || "application/octet-stream");
        xhr.setRequestHeader("X-QM-CSRF", "1");
        xhr.send(file);
      }

      uploadNext();
    }

    // UPLOAD FOLDER (ZIP ARCHIVE BUNDLE)
    async function uploadFolder(files) {
      if (!files || files.length === 0) return;
      const progressCard = $("upload-progress-card");
      const nameEl = $("upload-filename");
      const statsEl = $("upload-stats");
      const barEl = $("upload-bar-fill");

      progressCard.classList.remove("hidden");
      const job = activeUpload = { cancelled: false, xhr: null };

      // Extract top folder name(s)
      const folderSet = new Set();
      for (const f of files) {
        if (f.webkitRelativePath && f.webkitRelativePath.includes("/")) {
          folderSet.add(f.webkitRelativePath.split("/")[0]);
        }
      }
      const folderNames = Array.from(folderSet);
      let folderName = "Folder";
      if (folderNames.length === 1) folderName = folderNames[0];
      else if (folderNames.length === 2) folderName = `${folderNames[0]}_and_${folderNames[1]}`;
      else if (folderNames.length > 2) folderName = `${folderNames[0]}_${folderNames[1]}_and_${folderNames.length - 2}_more`;

      nameEl.textContent = QMI.t("Creating folder bundle: \"{name}.zip\"...", {name: folderName});
      barEl.style.width = "5%";
      statsEl.textContent = QMI.t("Initializing...");

      try {
        const initRes = await fetch("/api/share/folder/init", {
          method: "POST",
          headers: { "Content-Type": "application/json", "X-QM-CSRF": "1" },
          body: JSON.stringify({ folder_name: folderName, ttl: 7200 })
        });
        if (!initRes.ok) throw new Error(QMI.t("Could not initialize folder archive"));
        const { folder_id } = await initRes.json();

        // Stream each file into the folder ZIP
        for (let i = 0; i < files.length; i++) {
          const file = files[i];
          const relPath = file.webkitRelativePath || file.name;
          nameEl.textContent = QMI.t("Archiving folder \"{folder}\" ({i}/{n}): {name}", {folder: folderName, i: i + 1, n: files.length, name: file.name});

          await new Promise((resolve, reject) => {
            const xhr = new XMLHttpRequest();
            job.xhr = xhr;
            xhr.onabort = () => reject(new Error("cancelled"));
            let startTime = Date.now();
            xhr.upload.onprogress = (e) => {
              if (e.lengthComputable) {
                const percent = Math.round(((i + (e.loaded / e.total)) / files.length) * 100);
                barEl.style.width = `${percent}%`;
                const elapsedSec = (Date.now() - startTime) / 1000;
                const speed = elapsedSec > 0 ? e.loaded / elapsedSec : 0;
                statsEl.textContent = `${percent}% â€¢ ${formatBytes(speed)}/s`;
              }
            };
            xhr.onload = () => {
              if (xhr.status >= 200 && xhr.status < 300) resolve();
              else reject(new Error(xhr.statusText));
            };
            xhr.onerror = () => reject(new Error(QMI.t("Network error during file archive")));
            xhr.open("POST", `/api/share/folder/file?folder_id=${encodeURIComponent(folder_id)}&path=${encodeURIComponent(relPath)}`);
            xhr.setRequestHeader("Content-Type", file.type || "application/octet-stream");
            xhr.setRequestHeader("X-QM-CSRF", "1");
            xhr.send(file);
          });
        }

        // Finalize
        nameEl.textContent = QMI.t("Finalizing \"{name}.zip\"...", {name: folderName});
        const finRes = await fetch("/api/share/folder/finalize", {
          method: "POST",
          headers: { "Content-Type": "application/json", "X-QM-CSRF": "1" },
          body: JSON.stringify({ folder_id: folder_id })
        });
        if (!finRes.ok) throw new Error(QMI.t("Could not finalize folder archive"));

        barEl.style.width = "100%";
        statsEl.textContent = QMI.t("100% Complete");
        setTimeout(() => progressCard.classList.add("hidden"), 1200);
        showToast(QMI.t("Folder \"{name}\" uploaded successfully as a single package!", {name: folderName}));
        fetchShareData();

      } catch (err) {
        if (job.cancelled) return;
        showToast(QMI.t("Folder upload error: {err}", {err: err.message}));
        progressCard.classList.add("hidden");
      }
    }

